<% layout("/layouts/boilerplate") %>
<body>

    <div class="edit-form-container">
    
        <div class="row">
    
            <div class="col-md-12">
    
                <div class="row d-flex justify-content-center mb-3 mt-0">
                    <div class="col-md-12 text-center" style="font-size: 2rem;">
                        Edit Your Listing
                    </div>
                </div>
    
                <!-- Center the Image -->
                <div class="row">
                    <div class="col-md-12 d-flex justify-content-center"> <!-- text-center ensures proper centering -->
                        <img src="<%= listing.image.url %>" alt="Listing Image" class="edit-img">
                    </div>
                </div>
    
                <form class="row g-3 needs-validation mt-5" novalidate method="post"
                    action="/listings/<%= listing._id %>?_method=PUT" enctype="multipart/form-data">
    
                    <!-- Listing Name and Price in a Single Line -->
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="form-group position-relative">
                                <label for="listing-title" class="form-label mr-5">Listing Name</label>
                                <input type="text" id="listing-title" name="listing[title]" class="form-control "
                                    value="<%= listing.title %>" required>
                                <div class="invalid-feedback position-absolute">
                                    Please provide a title.
                                </div>
                            </div>
                        </div>
    
                        <div class="col-md-6">
                            <div class="form-group position-relative">
                                <label for="listing-price" class="form-label">Listing Price</label>
                                <input type="number" id="listing-price" name="listing[price]" class="form-control"
                                    value="<%= listing.price %>" required>
                                <div class="invalid-feedback position-absolute">
                                    Please provide a price.
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <!-- Listing Description in a Single Line -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <div class="form-group position-relative">
                                <label for="listing-description" class="form-label">Listing Description</label>
                                <textarea id="listing-description" name="listing[description]" class="form-control" required><%= listing.description %></textarea>
                                <div class="invalid-feedback position-absolute">
                                    Please provide a description.
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <!-- Listing Image Input in Another Line -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <label class="form-label">Listing Image</label>
    
                            <div class="row align-items-center">
                                <!-- Buttons on the left -->
                                <div class="col-auto d-flex">
    
    
                                    <div class="form-check p-0 me-2">
                                        <input type="radio" class="btn-outline form-check-input" id="urlImageOption"
                                            autocomplete="off" value="url" style="display: none;">
                                        <label class="btn form-check-label btn-outline-success" for="urlImageOption">Provide
                                            URL</label>
                                    </div>
    
                                    <div class="form-check p-0 ">
                                        <input type="radio" class="btn-outline form-check-input" id="uploadImageOption"
                                            autocomplete="off" value="upload" style="display: none;">
                                        <label class="btn form-check-label btn-outline-success"
                                            for="uploadImageOption">Upload Image</label>
                                    </div>
    
    
                                </div>
    
                                <!-- Input field covering remaining space -->
                                <div class="col">
                                    <!-- File Upload Input -->
                                    <input type="file" id="listing-file" name="listing[imageFile]" class="form-control "
                                        style="display: none;">
    
                                    <!-- URL Input (Initially Hidden) -->
                                    <input type="text" id="listing-url" name="listing[imageUrl]" class="form-control " placeholder="Provide image url link"
                                        value="<%= listing.image.url %>">
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <!-- Listing category in a Single Line -->
                    <div class="row mt-4">
                        <div class="col-md-12">
                            <label for="listing-categories" class="form-label">Categories</label>
                            <select id="listing-categories" size="10" name="listing[categories][]" class="form-select form-control"
                                multiple>
                                <% let selectedCategories=listing.categories || []; %>
                                    <% let allCategories=[ "amazing_pools" , "icons" , "omg" , "islands" , "countryside" , "new"
                                        , "amazing_views" , "farms" , "mansion" , "bed_and_breakfast" , "beachfront" , "luxe" , "tiny_homes"
                                        , "lake" , "towers" , "treehouses" , "top_of_the_world" , "room" , "cabins" , "skiing"
                                        , "national_parks" , "houseboats" , "arctic" , "camping" , "lakefront" , "boats" , "trending"
                                        , "domes" , "caves" , "play" , "a_frames" , "earth_homes" , "castles" , "tropical" , "camper_vans"
                                        , "design" , "surfing" , "historical_homes" , "top_cities" , "vineyards" , "golfing" , "hanoks"
                                        , "cycladic_homes" , "windmills" , "chefs_kitchens" , "shepherds_huts" , "casas_particulares"
                                        , "desert" , "ryokans" , "minsus" , "yurts" , "barns" , "ski-in_or_out" , "off_the_grid" , "adapted"
                                        , "containers" , "beach" , "riads" , "trulli" ]; %>
                    
                                        <% allCategories.forEach(category=> { %>
                                            <option value="<%= category %>" <% if (selectedCategories.includes(category)) { %> selected <% }
                                                    %>>
                                                    <%= category.replace(/_/g, " " ).toUpperCase() %>
                                            </option>
                                            <% }); %>
                            </select>
                            <small class="form-text text-muted">Hold down Ctrl (Windows) or Command (Mac) to select multiple
                                categories.</small>
                        </div>
                    </div>
    
                    <!-- Listing City and Country in a Single Line -->
                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="form-group position-relative">
                                <label for="listing-location" class="form-label">Listing City</label>
                                <input type="text" id="listing-location" name="listing[location]" class="form-control"
                                    value="<%= listing.location %>" required>
                                <div class="invalid-feedback position-absolute">
                                    Please provide a valid city.
                                </div>
                            </div>
                        </div>
    
                        <div class="col-md-6">
                            <div class="form-group position-relative">
                                <label for="listing-country" class="form-label">Listing Country</label>
                                <input type="text" id="listing-country" name="listing[country]" class="form-control"
                                    value="<%= listing.country %>" required>
                                <div class="invalid-feedback position-absolute">
                                    Please provide a valid country.
                                </div>
                            </div>
                        </div>
                    </div>
    
                    <!-- Submit Button -->
                    <div class="row mt-5 mb-4">
                        <div class="col-12 d-flex justify-content-center">
                            <button class="btn btn-primary w-50" type="submit">Edit</button>
                        </div>
                    </div>
    
    
                </form>
            </div>
        </div>
    
    </div>

    <script>
        // Toggle between file upload and URL input
        document.getElementById("uploadImageOption").addEventListener("click", function () {
            document.getElementById("listing-file").style.display = "block";
            document.getElementById("listing-url").value='';
            document.getElementById("listing-url").style.display = "none";
        });
    
        document.getElementById("urlImageOption").addEventListener("click", function () {
            document.getElementById("listing-file").style.display = "none";
            document.getElementById("listing-file").value='';
            document.getElementById("listing-url").style.display = "block";
        });
    </script>

       
</body>
