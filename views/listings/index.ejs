<% layout("/layouts/boilerplate") %>

<body>

    <div class="row">
        <div class="col-md-12" id="listings-container-parent">

            <div class="row">
                <div class="col-md-12">
                    <div class="category-container">

                        <div class="category-parent">
                            <button class="scroll-btn left-btn"><i class="fa fa-chevron-left"></i></button>
                        
                        <div class="category-list">
                            <div class="category-item active" data-category="all">
                                <i class="fa fa-list"></i> All Listings
                            </div>
                            <div class="category-item" data-category="amazing_pools"><i class="fa fa-swimming-pool"></i> Amazing Pools</div>
                            <div class="category-item" data-category="icons"><i class="fa fa-star"></i> Icons</div>
                            <div class="category-item" data-category="omg"><i class="fa fa-bolt"></i> OMG!</div>
                            <div class="category-item" data-category="islands"><i class="fa-solid fa-monument"></i> Islands</div>
                            <div class="category-item" data-category="countryside"><i class="fa fa-mountain"></i> Countryside</div>
                            <div class="category-item" data-category="new"><i class="fa fa-certificate"></i> New</div>
                            <div class="category-item" data-category="amazing_views"><i class="fa fa-eye"></i> Amazing Views</div>
                            <div class="category-item" data-category="farms"><i class="fa fa-tractor"></i> Farms</div>
                            <div class="category-item" data-category="mansion"><i class="fa fa-building"></i> Mansion</div>
                            <div class="category-item" data-category="bed_and_breakfast"><i class="fa fa-bed"></i> Bed & Breakfasts</div>
                            <div class="category-item" data-category="beachfront"><i class="fa fa-umbrella-beach"></i> Beachfront</div>
                            <div class="category-item" data-category="luxe"><i class="fa fa-gem"></i> Luxe</div>
                            <div class="category-item" data-category="tiny_homes"><i class="fa fa-home"></i> Tiny Homes</div>
                            <div class="category-item" data-category="lake"><i class="fa fa-water"></i> Lake</div>
                            <div class="category-item" data-category="towers"><i class="fa fa-city"></i> Towers</div>
                            <div class="category-item" data-category="treehouses"><i class="fa fa-tree"></i> Treehouses</div>
                            <div class="category-item" data-category="top_of_the_world"><i class="fa fa-mountain"></i> Top of the World</div>
                            <div class="category-item" data-category="room"><i class="fa fa-door-open"></i> Room</div>
                            <div class="category-item" data-category="cabins"><i class="fa fa-campground"></i> Cabins</div>
                            <div class="category-item" data-category="skiing"><i class="fa fa-skiing"></i> Skiing</div>
                            <div class="category-item" data-category="national_parks"><i class="fa fa-tree"></i> National Parks</div>
                            <div class="category-item" data-category="houseboats"><i class="fa fa-ship"></i> Houseboats</div>
                            <div class="category-item" data-category="arctic"><i class="fa fa-snowflake"></i> Arctic</div>
                            <div class="category-item" data-category="camping"><i class="fa fa-fire"></i> Camping</div>
                            <div class="category-item" data-category="lakefront"><i class="fa fa-water"></i> Lakefront</div>
                            <div class="category-item" data-category="boats"><i class="fa fa-anchor"></i> Boats</div>
                            <div class="category-item" data-category="trending"><i class="fa fa-chart-line"></i> Trending</div>
                            <div class="category-item" data-category="domes"><i class="fa fa-circle"></i> Domes</div>
                            <div class="category-item" data-category="caves"><i class="fa fa-mountain"></i> Caves</div>
                            <div class="category-item" data-category="play"><i class="fa fa-gamepad"></i> Play</div>
                            <div class="category-item" data-category="a_frames"><i class="fa fa-house-user"></i> A-Frames</div>
                            <div class="category-item" data-category="earth_homes"><i class="fa fa-seedling"></i> Earth Homes</div>
                            <div class="category-item" data-category="castles"><i class="fa fa-chess-rook"></i> Castles</div>
                            <div class="category-item" data-category="tropical"><i class="fa fa-umbrella-beach"></i> Tropical</div>
                            <div class="category-item" data-category="camper_vans"><i class="fa fa-caravan"></i> Camper Vans</div>
                            <div class="category-item" data-category="design"><i class="fa fa-paint-brush"></i> Design</div>
                            <div class="category-item" data-category="surfing"><i class="fa-solid fa-bridge-water"></i> Surfing</div>
                            <div class="category-item" data-category="historical_homes"><i class="fa fa-landmark"></i> Historical Homes</div>
                            <div class="category-item" data-category="top_cities"><i class="fa fa-city"></i> Top Cities</div>
                            <div class="category-item" data-category="vineyards"><i class="fa fa-wine-bottle"></i> Vineyards</div>
                            <div class="category-item" data-category="golfing"><i class="fa fa-golf-ball"></i> Golfing</div>
                            <div class="category-item" data-category="hanoks"><i class="fa fa-home"></i> Hanoks</div>
                            <div class="category-item" data-category="cycladic_homes"><i class="fa-solid fa-house-chimney-window"></i> Cycladic Homes</div>
                            <div class="category-item" data-category="windmills"><i class="fa fa-fan"></i> Windmills</div>
                            <div class="category-item" data-category="chefs_kitchens"><i class="fa fa-utensils"></i> Chef's Kitchens</div>
                            <div class="category-item" data-category="shepherds_huts"><i class="fa fa-house-user"></i> Shepherd's Huts</div>
                            <div class="category-item" data-category="casas_particulares"><i class="fa fa-home"></i> Casas Particulares</div>
                            <div class="category-item" data-category="desert"><i class="fa fa-sun"></i> Desert</div>
                            <div class="category-item" data-category="ryokans"><i class="fa fa-hotel"></i> Ryokans</div>
                            <div class="category-item" data-category="minsus"><i class="fa fa-bed"></i> Minsus</div>
                            <div class="category-item" data-category="yurts"><i class="fa fa-campground"></i> Yurts</div>
                            <div class="category-item" data-category="barns"><i class="fa fa-warehouse"></i> Barns</div>
                            <div class="category-item" data-category="ski-in_or_out"><i class="fa fa-skiing"></i> Ski-in/Ski-out</div>
                            <div class="category-item" data-category="off_the_grid"><i class="fa fa-tree"></i> Off the Grid</div>
                            <div class="category-item" data-category="adapted"><i class="fa fa-wheelchair"></i> Adapted</div>
                            <div class="category-item" data-category="containers"><i class="fa fa-box"></i> Containers</div>
                            <div class="category-item" data-category="beach"><i class="fa fa-umbrella-beach"></i> Beach</div>
                            <div class="category-item" data-category="riads"><i class="fa fa-home"></i> Riads</div>
                            <div class="category-item" data-category="trulli"><i class="fa fa-home"></i> Trulli</div>
                            <div class="category-item" data-category="eco_friendly"><i class="fa fa-leaf"></i> Eco Friendly</div>
                            <div class="category-item" data-category="luxury"><i class="fa fa-diamond"></i> Luxury</div>
                            <div class="category-item" data-category="mountain_views"><i class="fa fa-mountain"></i> Mountain Views</div>
                        
                        </div>
                
                        <button class="scroll-btn right-btn"><i class="fa fa-chevron-right"></i></button>
                        </div>
                        
                
                        <div class="right-controls">
                            <div class="toggle-container">
                                <div class="form-check-reverse form-switch" >
                                    <input class="form-check-input" type="checkbox" role="switch" id="flexSwitchCheckDefault" style="cursor: pointer;">
                                    <label class="form-check-label" for="flexSwitchCheckDefault" style="cursor: pointer;">Display total before taxes</label>
                                  </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        
            <div id="listings-container" class="mt-3">
                <div class="row row-cols-lg-4 row-cols-md-3 row-cols-sm-2 row-cols-1 mt-5 pt-3" style="width: 90vw;">
                    <% for(let listing of allListings) { %>
                        <div class="col  d-flex w-auto">
                            <a href="/listings/<%= listing._id %>" class="listing-anchors">
                                <div class="card listing-card" style="width: 100%; min-height: 100%;">
                                    <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_image" style="height: 18rem; border-radius: 1rem;">
                                    <div class="card-body">

                                        <div class="row row1">

                                            <div class="col-10 col1 p-0"><p class="card-text"><b style="font-weight: 800;"><%= listing.title %></b></p></div>

                                            <!-- ✅ Calculate rating average dynamically -->
                                            <div class="col-2 col 2" style="font-size: 12px;">
                                                <% let sum=0, ratingAvg=0; if (listing.reviews && listing.reviews.length> 0) {
                                                    sum = listing.reviews.reduce((acc, review) => acc + review.rating, 0);
                                                    ratingAvg = sum / listing.reviews.length;
                                                    }
                                                    %>
                                            
                                                    <div class="row" id="rating-box">
                                                        <div class="col-6 p-0 col2-1"><i class="fa-solid fa-star"></i></div>
                                                        <div class="col-6 p-0 col2-2">
                                                            <%= ratingAvg ? ratingAvg.toFixed(1) : "5.0" %>
                                                        </div>
                                                    </div>
                                            </div>

                                        </div>
                                         
                                        <p class="card-text location-box"><%= listing.location %>, <%= listing.country %></p>
                                        <p class="card-text price-box"><b style="font-weight: 800;">&#8377; <%= listing.price.toLocaleString('en-IN') %> <i class="tax" style="display: none;"> + 18% GST</i></b> /night </p>
                                    </div>
                                </div>
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
            

        </div>
    </div>

    <script src="/index.js"></script>

</body>

